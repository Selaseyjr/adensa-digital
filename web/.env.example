/**
 * Frontend environment configuration for the Adensa Digital
 * operational client.
 *
 * Copy to `.env.local` for development. `.env*` files are
 * git-ignored; never commit real configuration or secrets.
 *
 * Both variables are intentionally SERVER-side only (no
 * NEXT_PUBLIC_ prefix): the API client runs exclusively in
 * Server Components on the Node server, so the API origin and
 * the machine credential are never shipped to the browser. The
 * machine-to-machine X-API-Key mechanism (ADR-008) must never
 * be exposed through a public frontend variable — it is not
 * browser authentication. Human-user authentication remains a
 * future checkpoint.
 */

# FastAPI /v1 application boundary (ADR-011).
# Local development default; override per environment.
API_BASE_URL=http://127.0.0.1:8000

# Machine credential for the /v1 boundary. The Next.js server
# presents the same X-API-Key a trusted server-side integration
# (e.g. Power Automate) would present. Set this to the same
# value the API server receives via ADENSA_API_KEY.
# Optional only because the development API can run with
# unauthenticated /v1 reads in a fully local setup.
API_KEY=
