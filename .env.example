# Adensa Digital — environment configuration template.
#
# Copy to .env (git-ignored) and adjust per environment.
# Every variable is optional: with none set, the application
# runs the local SQLite development configuration.
#
# This file documents NAMES and FORMAT only. Never place real
# credentials here — .env.example is committed to source
# control; .env is not.

# ----------------------------------------------------------
# Database backend (app/config.py).
# Absent -> the default SQLite development database.
#
# SQLite (explicit path):
#   sqlite:///C:/absolute/path/to/adensa.db
#   sqlite:////absolute/posix/path/to/adensa.db
# PostgreSQL (P5.3; requires requirements-postgres.txt):
#   postgresql://user:password@host:5432/adensa
# Credentials live only in this variable — never log the URL.
# ----------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------
# Mutation API key (app/api.py, ADR-008).
# Required for the operational mutation endpoints (manual
# resolution, refresh, simulation); unconfigured = fail-closed.
# Generate a high-entropy value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Placeholder only — not a real key.
# ----------------------------------------------------------
ADENSA_API_KEY=change-me-per-environment

# ----------------------------------------------------------
# Browser origins allowed to call the API (app/api.py,
# ADR-011). Comma-separated list; empty = no browser origin
# is trusted. Never use "*" — the API carries operational
# data. Example (development frontend):
#   http://localhost:3000
# ----------------------------------------------------------
ADENSA_CORS_ORIGINS=
